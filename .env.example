# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; this example file is committed.

# ── Site ───────────────────────────────────────────────
# Public base URL, used for SEO metadata and absolute links.
# NEXT_PUBLIC_ values are baked in at build time; rebuild after changing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin panel ────────────────────────────────────────
# Owner account: always has every permission and can't be removed.
# Sign in at /admin with this email and ADMIN_PASSWORD. Other team members are
# added under Settings > Users with their own roles.
ADMIN_EMAIL=
ADMIN_NAME=

# Owner password. At least 8 characters. Required in production.
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. At least 32 random characters.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
ADMIN_SECRET=

# How long an admin stays signed in, in days (1-90).
ADMIN_SESSION_DAYS=7

# Secure (https-only) session cookie. Defaults to true in production.
# Set false ONLY when running production over plain http on a private machine.
# ADMIN_COOKIE_SECURE=true

# ── Storage ────────────────────────────────────────────
# Folder for content.json and leads.json, relative to the project root or absolute.
DATA_DIR=data
